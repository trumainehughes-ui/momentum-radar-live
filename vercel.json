{
  "version": 2,
  "headers": [
    {
      "source": "/((?!api(?:/|$)).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/nfl-health?cron=1",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/bdl-refresh",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/nba-health",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/nfl-game?mode=archive-history",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/nfl-health?cron=1&shard=1",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/nba-health?shard=1",
      "schedule": "*/15 * * * *"
    }
  ],
  "functions": {
    "api/nfl-markets.js": {
      "maxDuration": 300
    },
    "api/nfl-health.js": {
      "maxDuration": 300
    },
    "api/nfl-game.js": {
      "maxDuration": 300
    },
    "api/nfl-live.js": {
      "maxDuration": 120
    },
    "api/nfl-schedule.js": {
      "maxDuration": 120
    },
    "api/nfl-dvp.js": {
      "maxDuration": 300
    },
    "api/sports-data.js": {
      "maxDuration": 300
    },
    "api/nba-slate.js": {
      "maxDuration": 60
    },
    "api/nba-game.js": {
      "maxDuration": 90
    },
    "api/bdl-refresh.js": {
      "maxDuration": 120
    },
    "api/nba-health.js": {
      "maxDuration": 300
    }
  },
  "rewrites": [
    {
      "source": "/picks",
      "destination": "/picks.html"
    }
  ]
}
